DJANGO_SECRET_KEY=replace-with-a-long-random-secret
DJANGO_DEBUG=false
DJANGO_ALLOWED_HOSTS=sarkarinaukri.example,www.sarkarinaukri.example
DJANGO_CSRF_TRUSTED_ORIGINS=https://sarkarinaukri.example,https://www.sarkarinaukri.example
SITE_NAME=SarkariNaukri
SITE_URL=https://sarkarinaukri.example
TIME_ZONE=Asia/Kolkata
POSTGRES_DB=sarkari
POSTGRES_USER=sarkari
POSTGRES_PASSWORD=replace-with-a-strong-database-password
DATABASE_URL=postgresql://sarkari:replace-with-a-strong-database-password@db:5432/sarkari
REDIS_URL=redis://redis:6379/0
AUTO_PUBLISH_CONFIDENCE=0.97
ENABLE_COMPETITOR_DISCOVERY=false
AI_WEB_DISCOVERY_ENABLED=false
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5-mini
WEB_DISCOVERY_MODEL=gpt-5.4-mini
PUBLIC_JOB_SCHEMA_ENABLED=true

# Alerts
DEFAULT_FROM_EMAIL=alerts@sarkarinaukri.example
ADMIN_EMAIL=admin@sarkarinaukri.example
EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_HOST=smtp.example.com
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=true

# Browser push (optional)
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:admin@sarkarinaukri.example

# Google Indexing API (optional; service-account JSON as one-line JSON)
GOOGLE_INDEXING_ENABLED=false
GOOGLE_INDEXING_SERVICE_ACCOUNT_JSON=

# Staff TOTP 2FA (optional but recommended in production)
ADMIN_TOTP_SECRET=

# Security / throttling
RATE_LIMIT_PER_MINUTE=180
POST_RATE_LIMIT_PER_MINUTE=40
SECURE_SSL_REDIRECT=true
SESSION_COOKIE_SECURE=true
CSRF_COOKIE_SECURE=true
SENTRY_DSN=
